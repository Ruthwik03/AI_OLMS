git clone https://github.com/deepthisagar7/metro-reservation.git
cd metro-reservation
docker pull tomcat:9.0
docker pull mysql:8.0
grep -rn "jdbc" src/          # find the DB config file
find . -name "*.sql"          # find the SQL file, if any

mvn clean package
ls target/*.war

nano Dockerfile

FROM tomcat:9.0
COPY target/*.war /usr/local/tomcat/webapps/
EXPOSE 8080

nano docker-compose.yml

version: "3.8"

services:
  db:
    image: mysql:8.0
    container_name: mysql-db
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: root
      MYSQL_DATABASE: metrodb
    volumes:
      - db_data:/var/lib/mysql
      # - ./schema.sql:/docker-entrypoint-initdb.d/schema.sql
    networks:
      - metro-net

  app:
    build: .
    container_name: metro-web
    restart: always
    depends_on:
      - db
    ports:
      - "8080:8080"
    networks:
      - metro-net

volumes:
  db_data:

networks:
  metro-net:
    driver: bridge


docker compose up -d --build
docker compose ps
docker compose logs app
docker compose down
